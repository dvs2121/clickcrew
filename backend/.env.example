# Runtime mode used for configuration and error/security behavior.
NODE_ENV=development

# HTTP API port.
PORT=3000

# This project currently uses SQLite (node:sqlite), not PostgreSQL/Prisma.
# The path is relative to the backend working directory.
DATABASE_URL=file:./data/clickcrew.sqlite

# Optional direct path override; when set, this takes precedence over DATABASE_URL.
DATABASE_PATH=./data/clickcrew.sqlite

# Authentication configuration. Replace this placeholder with a unique,
# randomly generated secret before deploying; production requires at least 32 characters.
AUTH_SECRET=CHANGE_ME_generate_a_unique_local_secret_before_use

# Comma-separated allowed frontend origins for credentialed API requests.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Use secure cookies only when serving the API over HTTPS.
COOKIE_SECURE=false

# Optional one-time admin bootstrap. Leave both empty to disable it, or set both.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
